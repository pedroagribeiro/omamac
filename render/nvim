#!/usr/bin/env bash
# render/nvim <theme-dir> <state-dir>
set -uo pipefail
_here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${_here}/lib/log.sh"
source "${_here}/lib/colors.sh"
NVIM="${OMAMAC_NVIM:-nvim}"

theme_dir="$1"; state="$2"; toml="${theme_dir}/colors.toml"
[ -f "$toml" ] || { log_error "no colors.toml in ${theme_dir}"; exit 1; }
mkdir -p "${state}/current"

# Print '#rrggbb' for a colour key. A theme missing the key must never produce a
# malformed line like `#` — warn and fall back, so the target's parser still
# reads valid syntax.
c() {
  local v; v=$(omamac_color "$toml" "$1")
  if [ -z "$v" ]; then
    log_warn "theme $(basename "$theme_dir") is missing colour '$1'; using 000000"
    v="000000"
  fi
  printf '#%s' "$v"
}
if omamac_is_light "$toml"; then bgmode=light; else bgmode=dark; fi

cat > "${state}/current/omamac.lua" <<EOF
-- Generated by omamac. Do not edit; regenerated on every theme switch.
vim.o.termguicolors = true
vim.o.background = "${bgmode}"
vim.cmd("highlight clear")
vim.g.colors_name = "omamac"

local p = {
  bg = "$(c background)", fg = "$(c foreground)", cursor = "$(c cursor)",
  sel_bg = "$(c selection_background)", sel_fg = "$(c selection_foreground)",
  black = "$(c color0)", red = "$(c color1)", green = "$(c color2)",
  yellow = "$(c color3)", blue = "$(c color4)", magenta = "$(c color5)",
  cyan = "$(c color6)", white = "$(c color7)", grey = "$(c color8)",
}

local hl = vim.api.nvim_set_hl
hl(0, "Normal",       { fg = p.fg, bg = p.bg })
hl(0, "NormalFloat",  { fg = p.fg, bg = p.bg })
hl(0, "Cursor",       { fg = p.bg, bg = p.cursor })
hl(0, "CursorLine",   { bg = p.black })
hl(0, "LineNr",       { fg = p.grey })
hl(0, "CursorLineNr", { fg = p.yellow })
hl(0, "Visual",       { fg = p.sel_fg, bg = p.sel_bg })
hl(0, "Comment",      { fg = p.grey, italic = true })
hl(0, "String",       { fg = p.green })
hl(0, "Character",    { fg = p.green })
hl(0, "Number",       { fg = p.magenta })
hl(0, "Boolean",      { fg = p.magenta })
hl(0, "Function",     { fg = p.blue })
hl(0, "Identifier",   { fg = p.fg })
hl(0, "Keyword",      { fg = p.magenta })
hl(0, "Statement",    { fg = p.magenta })
hl(0, "Type",         { fg = p.yellow })
hl(0, "Constant",     { fg = p.cyan })
hl(0, "PreProc",      { fg = p.cyan })
hl(0, "Special",      { fg = p.cyan })
hl(0, "Error",        { fg = p.red })
hl(0, "WarningMsg",   { fg = p.yellow })
hl(0, "DiagnosticError", { fg = p.red })
hl(0, "DiagnosticWarn",  { fg = p.yellow })
hl(0, "DiagnosticInfo",  { fg = p.blue })
hl(0, "DiagnosticHint",  { fg = p.cyan })
hl(0, "Pmenu",        { fg = p.fg, bg = p.black })
hl(0, "PmenuSel",     { fg = p.sel_fg, bg = p.sel_bg })
hl(0, "StatusLine",   { fg = p.fg, bg = p.black })
hl(0, "VertSplit",    { fg = p.grey })
hl(0, "Search",       { fg = p.bg, bg = p.yellow })
hl(0, "IncSearch",    { fg = p.bg, bg = p.red })

vim.api.nvim_set_hl(0, "@variable", { fg = p.fg })
vim.api.nvim_set_hl(0, "@function", { link = "Function" })
vim.api.nvim_set_hl(0, "@keyword",  { link = "Keyword" })
vim.api.nvim_set_hl(0, "@string",   { link = "String" })
vim.api.nvim_set_hl(0, "@comment",  { link = "Comment" })
EOF

# Live-reload every running Neovim that exposes a socket.
for sock in "$HOME"/.cache/nvim/servers/*; do
  [ -S "$sock" ] || continue
  "$NVIM" --server "$sock" --remote-send \
    "<Esc>:luafile ${state}/current/omamac.lua<CR>" 2>/dev/null || true
done
