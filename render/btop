#!/usr/bin/env bash
# render/btop <theme-dir> <config-root>
set -uo pipefail
_here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${_here}/lib/log.sh"
source "${_here}/lib/colors.sh"

theme_dir="$1"; root="$2"; toml="${theme_dir}/colors.toml"
[ -f "$toml" ] || { log_error "no colors.toml in ${theme_dir}"; exit 1; }
mkdir -p "${root}/btop/themes"
# Shared hex-with-fallback lookup — see lib/colors.sh:omamac_hex_or_warn.
c() { omamac_hex_or_warn "$toml" "$1" "$(basename "$theme_dir")"; }

cat > "${root}/btop/themes/omamac.theme" <<EOF
# Generated by omamac.
theme[main_bg]="$(c background)"
theme[main_fg]="$(c foreground)"
theme[title]="$(c foreground)"
theme[hi_fg]="$(c color4)"
theme[selected_bg]="$(c selection_background)"
theme[selected_fg]="$(c selection_foreground)"
theme[inactive_fg]="$(c color8)"
theme[graph_text]="$(c foreground)"
theme[meter_bg]="$(c color8)"
theme[proc_misc]="$(c color6)"
theme[cpu_box]="$(c color4)"
theme[mem_box]="$(c color2)"
theme[net_box]="$(c color5)"
theme[proc_box]="$(c color3)"
theme[div_line]="$(c color8)"
theme[temp_start]="$(c color2)"
theme[temp_mid]="$(c color3)"
theme[temp_end]="$(c color1)"
theme[cpu_start]="$(c color2)"
theme[cpu_mid]="$(c color3)"
theme[cpu_end]="$(c color1)"
theme[free_start]="$(c color2)"
theme[free_mid]="$(c color6)"
theme[free_end]="$(c color4)"
theme[cached_start]="$(c color6)"
theme[cached_mid]="$(c color4)"
theme[cached_end]="$(c color5)"
theme[available_start]="$(c color3)"
theme[available_mid]="$(c color1)"
theme[available_end]="$(c color1)"
theme[used_start]="$(c color2)"
theme[used_mid]="$(c color3)"
theme[used_end]="$(c color1)"
theme[download_start]="$(c color2)"
theme[download_mid]="$(c color6)"
theme[download_end]="$(c color4)"
theme[upload_start]="$(c color3)"
theme[upload_mid]="$(c color5)"
theme[upload_end]="$(c color1)"
EOF

conf="${root}/btop/btop.conf"
if [ -f "$conf" ] && grep -q '^color_theme' "$conf"; then
  tmp=$(mktemp)
  sed -E 's|^color_theme.*|color_theme = "omamac"|' "$conf" > "$tmp" && mv "$tmp" "$conf"
else
  printf 'color_theme = "omamac"\n' >> "$conf"
fi
