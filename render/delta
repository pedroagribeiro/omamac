#!/usr/bin/env bash
# render/delta <theme-dir> <config-root>
#
# Writes <config-root>/git/omamac.ini — a [delta] block for git's pager.
#
# Pulled in by a one-time `[include] path = ~/.config/git/omamac.ini` at the
# END of the user's own git config, so these values win over whatever the
# committed [delta] section sets. Git silently ignores a missing include, so
# that line is harmless before omamac has ever run.
#
# There is no upstream counterpart: Omarchy's default/themed/ has templates for
# alacritty, btop, claude, ghostty, helix, kitty, neovim, obsidian and vscode,
# but none for delta. The mappings below are therefore chosen, not ported.
#
# `light` is the one that matters most. A hardcoded `light = false` renders
# diffs for a dark background no matter what the theme is, which is wrong for
# every light theme omamac ships (catppuccin-latte, flexoki-light, rose-pine,
# white...). Driving it from the theme is the whole point.
set -uo pipefail
_here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${_here}/lib/log.sh"
source "${_here}/lib/colors.sh"

theme_dir="$1"; root="$2"; toml="${theme_dir}/colors.toml"
[ -f "$toml" ] || { log_error "no colors.toml in ${theme_dir}"; exit 1; }
name=$(basename "$theme_dir")

# Shared hex-with-fallback lookup — see lib/colors.sh:omamac_hex_or_warn.
c() { omamac_hex_or_warn "$toml" "$1" "$name"; }
# `mix A B pct`, resolving both operands first; falls back to A so a missing
# key degrades to a readable colour rather than an empty value.
m() {
  local a b
  a=$(c "$1"); b=$(c "$2")
  omamac_mix "$a" "$b" "$3" || printf '%s' "$a"
}

if omamac_is_light "$toml"; then light="true"; else light="false"; fi

mkdir -p "${root}/git"
out="${root}/git/omamac.ini"
tmp="${root}/git/.omamac.ini.$$"

# Every colour is QUOTED. `#` starts a comment in git config, so an unquoted
# #rrggbb silently truncates the line to nothing — the value would vanish and
# delta would fall back to its defaults with no error anywhere.
#
# The 15%/32% tint strengths are the same ones render/claude uses for its diff
# backgrounds, so a diff looks the same weight in the pager as it does in
# Claude Code.
cat > "$tmp" <<EOF
# Generated by omamac from theme '${name}'. Edits here are overwritten.
[delta]
	syntax-theme = omamac
	light = ${light}
	plus-style = syntax "$(m background green 15%)"
	plus-emph-style = syntax "$(m background green 32%)"
	minus-style = syntax "$(m background red 15%)"
	minus-emph-style = syntax "$(m background red 32%)"
	line-numbers-plus-style = "$(c green)"
	line-numbers-minus-style = "$(c red)"
	line-numbers-zero-style = "$(c muted)"
EOF

# Renamed into place: git may be reading this at any moment (every diff, every
# log), and a half-written include is a config parse error rather than a
# slightly-wrong colour. Same discipline as render/claude and lib/fetch.sh.
mv -f "$tmp" "$out"
