#!/usr/bin/env bash
# render/ghostty <theme-dir> <config-root> [font-family]
set -uo pipefail
_here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${_here}/lib/log.sh"
source "${_here}/lib/colors.sh"

theme_dir="$1"; root="$2"; font="${3:-}"
toml="${theme_dir}/colors.toml"
[ -f "$toml" ] || { log_error "no colors.toml in ${theme_dir}"; exit 1; }

mkdir -p "${root}/ghostty/themes"

# Shared hex-with-fallback lookup — see lib/colors.sh:omamac_hex_or_warn.
c() { omamac_hex_or_warn "$toml" "$1" "$(basename "$theme_dir")"; }

{
  for i in $(seq 0 15); do
    printf 'palette = %d=%s\n' "$i" "$(c "color$i")"
  done
  printf 'background = %s\n'           "$(c background)"
  printf 'foreground = %s\n'           "$(c foreground)"
  printf 'cursor-color = %s\n'         "$(c cursor)"
  printf 'selection-background = %s\n' "$(c selection_background)"
  printf 'selection-foreground = %s\n' "$(c selection_foreground)"
} > "${root}/ghostty/themes/omamac"

{
  printf 'theme = omamac\n'
  # A `theme` include only supplies values the user hasn't set explicitly, so
  # a cursor-color line in themes/omamac is dead against a config that sets
  # one (e.g. ~/.dotfiles' committed `cursor-color = #ffffff`). omamac.conf is
  # a plain config-file include, applied LAST — later values win there — so
  # emitting cursor-color here is what actually makes the theme's cursor
  # colour take effect over an explicit user setting.
  printf 'cursor-color = %s\n' "$(c cursor)"
  if [ -n "$font" ]; then
    # font-family accumulates into a fallback chain in Ghostty; reset it first
    # or the committed family stays primary.
    printf 'font-family = ""\n'
    printf 'font-family = "%s"\n' "$font"
  fi
} > "${root}/ghostty/omamac.conf"
