#!/usr/bin/env bash
# render/zed <theme-dir> <config-root>
#
# Writes <config-root>/zed/themes/omamac.json — a Zed theme.
#
# Zed watches its themes directory and reloads on change, so an open editor
# retints without restarting. That is also why the file is renamed into place:
# a reader can arrive mid-write, and a half-written theme is a parse error
# rather than a slightly-wrong colour.
#
# Selecting it is a one-time, separate step: `"theme": "omamac"` in
# ~/.config/zed/settings.json. omamac does not write that file — under
# home-manager it is a read-only symlink into the Nix store, and the pointer
# belongs in the dotfiles anyway. Only the theme file is generated.
#
# Every field the v0.2.0 schema defines is emitted rather than a chosen subset,
# so there is no question of which keys Zed will fall back on. The palette is
# resolved into variables once: `c` shells out to a sed over colors.toml, and
# there are ~160 fields.
set -uo pipefail
_here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${_here}/lib/log.sh"
source "${_here}/lib/colors.sh"

theme_dir="$1"; root="$2"; toml="${theme_dir}/colors.toml"
[ -f "$toml" ] || { log_error "no colors.toml in ${theme_dir}"; exit 1; }
name=$(basename "$theme_dir")

c() { omamac_hex_or_warn "$toml" "$1" "$name"; }
m() {
  local a b
  a=$(c "$1"); b=$(c "$2")
  omamac_mix "$a" "$b" "$3" || printf '%s' "$a"
}

if omamac_is_light "$toml"; then appearance="light"; else appearance="dark"; fi

# ── palette ────────────────────────────────────────────────────────────────
BG=$(c background);            FG=$(c foreground)
ACCENT=$(c accent);            MUTED=$(c muted)
SEL=$(c selection_background); CURSOR=$(c cursor)
RED=$(c red);       GREEN=$(c green);   YELLOW=$(c yellow)
BLUE=$(c blue);     MAGENTA=$(c magenta); CYAN=$(c cyan)
BR_RED=$(c bright_red);       BR_GREEN=$(c bright_green)
BR_YELLOW=$(c bright_yellow); BR_BLUE=$(c bright_blue)
BR_MAGENTA=$(c bright_magenta); BR_CYAN=$(c bright_cyan)
BLACK=$(c color0);  WHITE=$(c color7)
BR_BLACK=$(c color8); BR_WHITE=$(c color15)

# ── derived shades ─────────────────────────────────────────────────────────
# Everything that is not a palette colour is the background nudged toward the
# foreground (or vice versa) by a fixed amount, so a theme's own contrast
# carries through instead of a hardcoded grey.
SURFACE=$(m background foreground 3%)     # panels, tab bar, status bar
ELEVATED=$(m background foreground 6%)    # popovers above the surface
HOVER=$(m background foreground 8%)       # hovered rows
ACTIVE=$(m background foreground 12%)     # pressed rows
BORDER=$(m background foreground 20%)     # dividers
BORDER_VARIANT=$(m background foreground 12%)
LINE=$(m background foreground 4%)        # active line, gutter highlight
DIM_FG=$(m foreground background 35%)     # line numbers, muted icons
FAINT_FG=$(m foreground background 55%)   # placeholders, disabled
INVISIBLE=$(m foreground background 70%)  # whitespace marks
DIFF_ADD=$(m background green 15%)
DIFF_MOD=$(m background yellow 15%)
DIFF_DEL=$(m background red 15%)
ERR_BG=$(m background red 12%)
WARN_BG=$(m background yellow 12%)
INFO_BG=$(m background blue 12%)
HINT_BG=$(m background cyan 12%)

mkdir -p "${root}/zed/themes"
out="${root}/zed/themes/omamac.json"
tmp="${root}/zed/themes/.omamac.json.$$"

cat > "$tmp" <<EOF
{
  "\$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "omamac",
  "author": "Generated by omamac from theme '${name}'",
  "themes": [
    {
      "name": "omamac",
      "appearance": "${appearance}",
      "style": {
        "border": "${BORDER}",
        "border.variant": "${BORDER_VARIANT}",
        "border.focused": "${ACCENT}",
        "border.selected": "${ACCENT}",
        "border.transparent": "${BG}",
        "border.disabled": "${BORDER_VARIANT}",
        "elevated_surface.background": "${ELEVATED}",
        "surface.background": "${SURFACE}",
        "background": "${BG}",
        "element.background": "${SURFACE}",
        "element.hover": "${HOVER}",
        "element.active": "${ACTIVE}",
        "element.selected": "${SEL}",
        "element.disabled": "${SURFACE}",
        "drop_target.background": "${HOVER}",
        "ghost_element.background": "${BG}",
        "ghost_element.hover": "${HOVER}",
        "ghost_element.active": "${ACTIVE}",
        "ghost_element.selected": "${SEL}",
        "ghost_element.disabled": "${SURFACE}",
        "text": "${FG}",
        "text.muted": "${MUTED}",
        "text.placeholder": "${FAINT_FG}",
        "text.disabled": "${FAINT_FG}",
        "text.accent": "${ACCENT}",
        "icon": "${FG}",
        "icon.muted": "${MUTED}",
        "icon.disabled": "${FAINT_FG}",
        "icon.placeholder": "${FAINT_FG}",
        "icon.accent": "${ACCENT}",
        "status_bar.background": "${SURFACE}",
        "title_bar.background": "${SURFACE}",
        "title_bar.inactive_background": "${BG}",
        "toolbar.background": "${BG}",
        "tab_bar.background": "${SURFACE}",
        "tab.inactive_background": "${SURFACE}",
        "tab.active_background": "${BG}",
        "search.match_background": "${SEL}",
        "panel.background": "${SURFACE}",
        "panel.focused_border": "${ACCENT}",
        "pane.focused_border": "${ACCENT}",
        "scrollbar.thumb.background": "${ACTIVE}",
        "scrollbar.thumb.hover_background": "${BORDER}",
        "scrollbar.thumb.border": "${BORDER_VARIANT}",
        "scrollbar.track.background": "${BG}",
        "scrollbar.track.border": "${BORDER_VARIANT}",
        "editor.foreground": "${FG}",
        "editor.background": "${BG}",
        "editor.gutter.background": "${BG}",
        "editor.subheader.background": "${SURFACE}",
        "editor.active_line.background": "${LINE}",
        "editor.highlighted_line.background": "${HOVER}",
        "editor.line_number": "${DIM_FG}",
        "editor.active_line_number": "${FG}",
        "editor.invisible": "${INVISIBLE}",
        "editor.wrap_guide": "${BORDER_VARIANT}",
        "editor.active_wrap_guide": "${BORDER}",
        "editor.document_highlight.read_background": "${HOVER}",
        "editor.document_highlight.write_background": "${ACTIVE}",
        "terminal.background": "${BG}",
        "terminal.foreground": "${FG}",
        "terminal.bright_foreground": "${BR_WHITE}",
        "terminal.dim_foreground": "${MUTED}",
        "link_text.hover": "${ACCENT}",
        "conflict": "${YELLOW}",
        "conflict.background": "${WARN_BG}",
        "conflict.border": "${YELLOW}",
        "created": "${GREEN}",
        "created.background": "${DIFF_ADD}",
        "created.border": "${GREEN}",
        "deleted": "${RED}",
        "deleted.background": "${DIFF_DEL}",
        "deleted.border": "${RED}",
        "modified": "${YELLOW}",
        "modified.background": "${DIFF_MOD}",
        "modified.border": "${YELLOW}",
        "renamed": "${BLUE}",
        "hidden": "${FAINT_FG}",
        "ignored": "${MUTED}",
        "error": "${RED}",
        "error.background": "${ERR_BG}",
        "error.border": "${RED}",
        "warning": "${YELLOW}",
        "warning.background": "${WARN_BG}",
        "warning.border": "${YELLOW}",
        "info": "${BLUE}",
        "info.background": "${INFO_BG}",
        "info.border": "${BLUE}",
        "hint": "${CYAN}",
        "hint.background": "${HINT_BG}",
        "hint.border": "${CYAN}",
        "predictive": "${DIM_FG}",
        "success": "${GREEN}",
        "unreachable": "${FAINT_FG}",
        "terminal.ansi.black": "${BLACK}",
        "terminal.ansi.bright_black": "${BR_BLACK}",
        "terminal.ansi.dim_black": "${BLACK}",
        "terminal.ansi.red": "${RED}",
        "terminal.ansi.bright_red": "${BR_RED}",
        "terminal.ansi.dim_red": "${RED}",
        "terminal.ansi.green": "${GREEN}",
        "terminal.ansi.bright_green": "${BR_GREEN}",
        "terminal.ansi.dim_green": "${GREEN}",
        "terminal.ansi.yellow": "${YELLOW}",
        "terminal.ansi.bright_yellow": "${BR_YELLOW}",
        "terminal.ansi.dim_yellow": "${YELLOW}",
        "terminal.ansi.blue": "${BLUE}",
        "terminal.ansi.bright_blue": "${BR_BLUE}",
        "terminal.ansi.dim_blue": "${BLUE}",
        "terminal.ansi.magenta": "${MAGENTA}",
        "terminal.ansi.bright_magenta": "${BR_MAGENTA}",
        "terminal.ansi.dim_magenta": "${MAGENTA}",
        "terminal.ansi.cyan": "${CYAN}",
        "terminal.ansi.bright_cyan": "${BR_CYAN}",
        "terminal.ansi.dim_cyan": "${CYAN}",
        "terminal.ansi.white": "${WHITE}",
        "terminal.ansi.bright_white": "${BR_WHITE}",
        "terminal.ansi.dim_white": "${WHITE}",
        "players": [
          {
            "cursor": "${CURSOR}",
            "background": "${ACCENT}",
            "selection": "${SEL}"
          }
        ],
        "syntax": {
          "comment": { "color": "${MUTED}", "font_style": "italic" },
          "comment.doc": { "color": "${MUTED}", "font_style": "italic" },
          "keyword": { "color": "${MAGENTA}" },
          "operator": { "color": "${CYAN}" },
          "string": { "color": "${GREEN}" },
          "string.escape": { "color": "${BR_GREEN}" },
          "string.regex": { "color": "${BR_GREEN}" },
          "string.special": { "color": "${BR_GREEN}" },
          "string.special.symbol": { "color": "${GREEN}" },
          "number": { "color": "${BR_MAGENTA}" },
          "boolean": { "color": "${BR_MAGENTA}" },
          "constant": { "color": "${BR_MAGENTA}" },
          "function": { "color": "${BLUE}" },
          "function.method": { "color": "${BLUE}" },
          "constructor": { "color": "${BR_BLUE}" },
          "type": { "color": "${YELLOW}" },
          "type.builtin": { "color": "${BR_YELLOW}" },
          "variable": { "color": "${FG}" },
          "variable.special": { "color": "${RED}" },
          "property": { "color": "${CYAN}" },
          "attribute": { "color": "${BR_CYAN}" },
          "tag": { "color": "${RED}" },
          "title": { "color": "${BLUE}", "font_weight": 700 },
          "emphasis": { "color": "${FG}", "font_style": "italic" },
          "emphasis.strong": { "color": "${FG}", "font_weight": 700 },
          "link_uri": { "color": "${CYAN}" },
          "link_text": { "color": "${ACCENT}", "font_style": "italic" },
          "punctuation": { "color": "${FG}" },
          "punctuation.bracket": { "color": "${MUTED}" },
          "punctuation.delimiter": { "color": "${MUTED}" },
          "punctuation.list_marker": { "color": "${CYAN}" },
          "punctuation.special": { "color": "${BR_MAGENTA}" },
          "preproc": { "color": "${MAGENTA}" },
          "enum": { "color": "${YELLOW}" },
          "variant": { "color": "${BR_YELLOW}" },
          "label": { "color": "${BLUE}" },
          "predictive": { "color": "${DIM_FG}", "font_style": "italic" },
          "hint": { "color": "${CYAN}" },
          "primary": { "color": "${FG}" }
        }
      }
    }
  ]
}
EOF

# mv within one directory is atomic, so a watching Zed never observes a partial
# file under the real name — the same discipline render/claude and lib/fetch.sh
# use, and for the same reason.
mv -f "$tmp" "$out"
