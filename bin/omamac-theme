#!/usr/bin/env bash
# omamac-theme [name|--list|--current]
set -uo pipefail
OMAMAC_DIR="${OMAMAC_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
source "${OMAMAC_DIR}/lib/log.sh"
source "${OMAMAC_DIR}/lib/state.sh"

THEMES_DIR="${OMAMAC_THEMES_DIR:-${OMAMAC_DIR}/themes}"
CONFIG_ROOT="${OMAMAC_CONFIG_ROOT:-$HOME/.config}"
# Claude Code lives at ~/.claude, not under XDG config, and honours
# CLAUDE_CONFIG_DIR — same override upstream's omarchy-theme-set-claude reads.
CLAUDE_DIR="${OMAMAC_CLAUDE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
OMAMAC_KILL="${OMAMAC_KILL:-kill}"
OMAMAC_PS="${OMAMAC_PS:-ps}"

# A theme is a DIRECTORY CONTAINING colors.toml — the same thing theme_set
# requires before it will apply one. A bare `ls` here listed everything in the
# directory, including files that are deliberately not themes:
# themes/LICENSE.omarchy carries Omarchy's MIT notice beside the vendored
# colours. That offered "LICENSE" as a selectable theme which nothing could
# resolve, so the picker drew it as a blank panel.
theme_list() {
  local d
  for d in "$THEMES_DIR"/*/; do
    [ -f "${d}colors.toml" ] || continue
    basename "$d"
  done 2>/dev/null | sort
}
theme_current() { omamac_state_get theme.name; }

# Signal every running Ghostty. Matches the executable path because macOS
# pgrep does not match Ghostty's process name, and pkill -f self-matches.
ghostty_reload() {
  local pids
  pids=$("$OMAMAC_PS" -axo pid=,comm= | awk '/Ghostty\.app\/Contents\/MacOS\/ghostty$/{print $1}')
  [ -n "$pids" ] || return 1
  # shellcheck disable=SC2086
  "$OMAMAC_KILL" -USR2 $pids 2>/dev/null || return 1
}

# Apply this theme's first cached (or freshly fetched) wallpaper, unless the
# recorded background already points into its cache directory. Reuses
# omamac-bg's --list/set rather than re-deriving the cache path or the
# "first" ordering here. Non-fatal: a theme with no cached/fetchable
# backgrounds is not an error, and a wallpaper failure never fails the
# switch — only render/ghostty's colors.toml check is a hard failure.
#
# If nothing is cached yet, `bg --list` would trigger a full fetch of the
# theme's backgrounds.index — several megabytes on a first visit, and the
# reason theme switches used to take ~7s. That download must never hold up
# the switch, so it is kicked off detached instead of run in line; the
# synchronous "apply the first cached wallpaper" path below is unaffected
# and stays exactly as fast as before.
apply_theme_wallpaper() {
  local name="$1" cache_dir cur_bg first
  cache_dir="${OMAMAC_CACHE}/backgrounds/${name}"
  cur_bg=$(omamac_state_get background)
  case "$cur_bg" in
    "${cache_dir}/"*) return 0 ;;
  esac

  if [ -n "$(ls -A "$cache_dir" 2>/dev/null)" ]; then
    first=$("${OMAMAC_DIR}/bin/omamac-bg" --list 2>/dev/null | head -1)
    [ -n "$first" ] || return 0
    "${OMAMAC_DIR}/bin/omamac-bg" "$first" >/dev/null 2>&1 || log_warn "could not set wallpaper for ${name}"
    return 0
  fi

  # Nothing cached: a theme with no backgrounds.index has nothing to fetch
  # either way, and that must stay a silent no-op — not a spawned job.
  [ -f "${THEMES_DIR}/${name}/backgrounds.index" ] || return 0

  log_info "Wallpaper: fetching ${name}'s backgrounds in the background; it will appear in a few seconds."
  # macOS has no setsid. `set -m` inside a subshell is what gives the
  # backgrounded job its OWN process group (ordinary bash job-control
  # behaviour) instead of inheriting this script's — this CLI is launched
  # from Hammerspoon via hs.task, and a child left in the SAME process
  # group as this script can be killed the moment hs.task tears the parent
  # down, well before a multi-megabyte download finishes. nohup (ignoring
  # SIGHUP) covers the other common teardown path. Runs the exact same
  # "list, take the first entry, set it" sequence as the synchronous branch
  # above, just detached and a few seconds later.
  (
    set -m
    nohup bash -c '
      first=$("$1/bin/omamac-bg" --list 2>/dev/null | head -1)
      [ -n "$first" ] && "$1/bin/omamac-bg" "$first" >/dev/null 2>&1
    ' _ "$OMAMAC_DIR" >/dev/null 2>&1 &
    disown
  )
}

theme_set() {
  local name="$1" dir font pid_nvim pid_btop pid_bat pid_macos
  dir="${THEMES_DIR}/${name}"
  [ -d "$dir" ] || { log_error "unknown theme: ${name}"; return 1; }
  # The single hard-failure condition: a theme this can't even resolve
  # colours for. render/ghostty also checks this, but it doubles as the
  # renderer's OWN failure signal (e.g. an unwritable ~/.config/ghostty, a
  # full disk) — those must not abort the switch, since nvim/btop/bat/macos
  # can and should still apply. Checking it here, explicitly, is what keeps
  # "theme unresolvable" and "one target's render failed" from being
  # conflated into the same exit code.
  [ -f "${dir}/colors.toml" ] || { log_error "theme ${name} has no colors.toml"; return 1; }

  font=$(omamac_state_get font)
  font_size=$(omamac_state_get font.size)

  # Ghostty first, and reload it immediately: it's the one renderer the user
  # is looking at, so time-to-visible-change must not wait on the other four
  # renderers, the state write, or a wallpaper fetch.
  "${OMAMAC_DIR}/render/ghostty" "$dir" "$CONFIG_ROOT" "$font" "$font_size" || log_warn "ghostty render failed"
  if ghostty_reload; then
    log_info "Ghostty: reloaded ${name}."
  else
    log_info "Ghostty: applied ${name} (not running; applies on next launch)."
  fi

  # nvim/btop/bat/delta/claude/macos write to distinct paths and don't depend on
  # each other or on Ghostty, so run them concurrently rather than paying for
  # six renderers sequentially. theme_set must still not return until all
  # six are done — tests assert on their output files right after the
  # command — so each is `wait`ed individually by its own pid: that is what
  # lets a failing renderer log its own specific warning instead of
  # collapsing all six into one generic message.
  "${OMAMAC_DIR}/render/nvim"   "$dir" "$OMAMAC_STATE" & pid_nvim=$!
  "${OMAMAC_DIR}/render/btop"   "$dir" "$CONFIG_ROOT"  & pid_btop=$!
  "${OMAMAC_DIR}/render/bat"    "$dir" "$CONFIG_ROOT"  & pid_bat=$!
  "${OMAMAC_DIR}/render/delta"  "$dir" "$CONFIG_ROOT"  & pid_delta=$!
  "${OMAMAC_DIR}/render/claude" "$dir" "$CLAUDE_DIR"   & pid_claude=$!
  "${OMAMAC_DIR}/render/macos"  "$dir"                 & pid_macos=$!

  wait "$pid_nvim"   || log_warn "nvim render failed"
  wait "$pid_btop"   || log_warn "btop render failed"
  wait "$pid_bat"    || log_warn "bat render failed"
  wait "$pid_delta"  || log_warn "delta render failed"
  wait "$pid_claude" || log_warn "claude render failed"
  wait "$pid_macos"  || log_warn "could not set system appearance"

  omamac_state_set theme.name "$name"
  apply_theme_wallpaper "$name"
}

case "${1:-}" in
  --list)    theme_list ;;
  --current) theme_current ;;
  "")        theme_current ;;
  *)         theme_set "$1" ;;
esac
