#!/usr/bin/env bash
# omamac-font [family|--list|--current]
set -uo pipefail
OMAMAC_DIR="${OMAMAC_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
source "${OMAMAC_DIR}/lib/log.sh"
source "${OMAMAC_DIR}/lib/state.sh"
GHOSTTY="${OMAMAC_GHOSTTY:-/Applications/Ghostty.app/Contents/MacOS/ghostty}"

# Which families the picker offers, as a case-insensitive ERE.
#
# Every source below already reports only monospace families — `ghostty
# +list-fonts` lists what Ghostty will accept as a terminal font, and fc-list
# is asked for :spacing=100 — so "monospace" is not the useful axis. What that
# still lets through is CJK system faces (Lantinghei TC, Osaka, PCMyungjo):
# fixed-width for CJK, useless as coding fonts, and most of what made the list
# feel long. Narrowing to Nerd Fonts is what actually shortens it.
#
# Detection is by naming convention because it is the only signal available:
# fontconfig does not work on Darwin (see font_list_raw) and CoreText is not
# reachable from the shell. Patched families are named "<X> Nerd Font",
# optionally " Mono"/" Propo", or suffixed " NF"/" NFM"/" NFP" — Monaspace
# ships as "Monaspace Argon NF", so matching only "Nerd Font" would silently
# drop that whole family.
#
# Overridable, so the list can be widened without editing this file:
#   OMAMAC_FONT_FILTER='.' omamac font --list     # everything the source has
OMAMAC_FONT_FILTER="${OMAMAC_FONT_FILTER:-nerd font|(^| )nf[mp]?$}"

# Font source resolution, in priority order:
#   1. OMAMAC_FCLIST, if the caller EXPLICITLY set it (tests stub this; the
#      `${OMAMAC_FCLIST+x}` check, not `:-`, is what lets an explicit empty/odd
#      value still win over auto-detection below).
#   2. Ghostty's own `+list-fonts`, when a Ghostty binary is available and
#      executable. On Darwin this is what's actually reliable: `fc-list`
#      requires a working fontconfig, which `fonts.fontconfig.enable` in
#      home-manager does not provide on macOS (no `~/.config/fontconfig/`,
#      no default config file, so Nix's fc-list errors out with zero families).
#      Ghostty needs no fontconfig and is exactly the set of fonts Ghostty
#      itself will accept.
#   3. Plain `fc-list`, for Linux or a machine where fontconfig genuinely works.
font_list_raw() {
  if [ "${OMAMAC_FCLIST+x}" = "x" ]; then
    "$OMAMAC_FCLIST" :spacing=100 -f "%{family[0]}\n" 2>/dev/null
  elif [ -x "$GHOSTTY" ]; then
    # `+list-fonts` prints a family name on an unindented line, followed by
    # its style names on indented lines, with blank lines between families.
    # Keeping only unindented, non-empty lines yields just the family names —
    # taking indented lines too would offer unselectable style names as fonts.
    "$GHOSTTY" +list-fonts 2>/dev/null | grep -E '^[^[:space:]]'
  else
    fc-list :spacing=100 -f "%{family[0]}\n" 2>/dev/null
  fi
}

font_list() {
  # `|| true` throughout: under `pipefail`, grep exits 1 when it emits no
  # lines — which happens legitimately whenever no font source is available,
  # or when nothing matches the filter. That must stay a clean, empty result,
  # not a failure that trips the script's exit code (there's no `set -e`, but
  # the case statement below returns font_list's own status as the script's
  # exit status).
  local available filtered current
  available=$(font_list_raw | grep -v -i -E 'emoji|signwriting' | grep -v -E '^\.' || true)
  filtered=$(printf '%s\n' "$available" | grep -i -E "$OMAMAC_FONT_FILTER" || true)

  # The font currently in use is always offered, filter or not. It is the row
  # the menu marks with a check, and a picker that cannot show what is applied
  # is worse than one carrying an extra row — which matters here because the
  # list was unfiltered until now, so a font chosen earlier can easily be one
  # the filter rejects. Only if it is genuinely installed, though: injecting a
  # name no source reports would offer a row that font_set then refuses.
  current=$(omamac_state_get font)
  if [ -n "$current" ] && printf '%s\n' "$available" | grep -qxF "$current"; then
    filtered=$(printf '%s\n%s\n' "$filtered" "$current")
  fi

  printf '%s\n' "$filtered" | grep -v '^$' | sort -u || true
}

font_set() {
  local family="$1" theme prev
  font_list | grep -qxF "$family" || { log_error "font not available: ${family}"; return 1; }
  # theme_set reads the font back out of state, so the write has to come first.
  # That makes the write speculative: if the re-render fails, roll it back, or
  # `font --current` would report a font that was never rendered.
  prev=$(omamac_state_get font)
  omamac_state_set font "$family"
  theme=$(omamac_state_get theme.name)
  if [ -n "$theme" ]; then
    if ! "${OMAMAC_DIR}/bin/omamac-theme" "$theme"; then
      omamac_state_set font "$prev"
      log_error "could not apply font ${family}; reverted to ${prev:-none}"
      return 1
    fi
  fi
  log_info "Font set to ${family}."
}

case "${1:-}" in
  --list)    font_list ;;
  --current) omamac_state_get font ;;
  "")        omamac_state_get font ;;
  *)         font_set "$1" ;;
esac
