#!/usr/bin/env bash
# install — Homebrew path for non-Nix users.
#
# Installs the runtime dependency (jq) and Hammerspoon via Homebrew, symlinks
# `bin/omamac` onto PATH, writes ~/.hammerspoon/init.lua to load the omamac
# host, and reminds you to grant Accessibility permission.
#
# Nix users do not run this: `nix build .#` (or the home-manager module in
# ~/.dotfiles) covers packaging and the Hammerspoon host instead.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
bin_dir="$HOME/.local/bin"
hammerspoon_init="$HOME/.hammerspoon/init.lua"

log()  { printf '\033[1;32m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$1" >&2; }

if ! command -v brew >/dev/null 2>&1; then
  warn "Homebrew not found. Install it from https://brew.sh and re-run this script."
  exit 1
fi

log "Installing jq..."
brew list jq >/dev/null 2>&1 || brew install jq

log "Installing Hammerspoon..."
brew list --cask hammerspoon >/dev/null 2>&1 || brew install --cask hammerspoon

log "Linking omamac into ${bin_dir}..."
mkdir -p "$bin_dir"
ln -sf "${here}/bin/omamac" "${bin_dir}/omamac"

if [ -e "$hammerspoon_init" ] && [ ! -L "$hammerspoon_init" ]; then
  warn "${hammerspoon_init} already exists and was not written by this script."
  warn "Back it up, then add this line to it yourself:"
  warn "  dofile(\"${here}/hammerspoon/omamac.lua\")"
else
  log "Writing ${hammerspoon_init}..."
  mkdir -p "$(dirname "$hammerspoon_init")"
  cat > "$hammerspoon_init" <<EOF
-- Generated by omamac's install script. OMAMAC_DIR is written in literally
-- because Hammerspoon.app inherits no shell environment.
OMAMAC_DIR = "${here}"
dofile(OMAMAC_DIR .. "/hammerspoon/omamac.lua")
EOF
fi

log "Done."
cat <<'EOF'

Next steps:
  1. Launch Hammerspoon (Applications > Hammerspoon), then grant it
     Accessibility permission when macOS prompts you:
     System Settings > Privacy & Security > Accessibility > enable Hammerspoon.
  2. Press cmd+alt+O to open the theme menu, cmd+ctrl+space to cycle
     wallpapers.
  3. Optional, to pick up theme changes in the other tools: add
     `config-file = ?omamac.conf` as the LAST line of your Ghostty config,
     and the delta / Claude Code / bat / Neovim snippets from README.md.
  4. Run `omamac doctor` to check everything landed.
EOF
