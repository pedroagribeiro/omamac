#!/usr/bin/env bash
# install — the Homebrew path, for people not using Nix.
#
# Works two ways, and has to, because the second is how anyone finds it first:
#
#   ./install                                   from a checkout
#   curl -fsSL <raw-url>/install | bash         from nothing at all
#
# Piped, there is no checkout to install FROM, so it clones one first. Re-run it
# to upgrade: it pulls, relinks, and leaves everything else alone.
#
# Nix users do not run this. `nix build .#`, or the home-manager module in
# ~/.dotfiles, covers packaging and the Hammerspoon host instead.
set -uo pipefail

REPO="${OMAMAC_REPO:-https://github.com/pedroagribeiro/omamac.git}"
INSTALL_DIR="${OMAMAC_INSTALL_DIR:-$HOME/.local/share/omamac}"
BIN_DIR="${OMAMAC_BIN_DIR:-$HOME/.local/bin}"
HS_INIT="${OMAMAC_HS_INIT:-$HOME/.hammerspoon/init.lua}"
BREW="${OMAMAC_BREW:-brew}"
GIT="${OMAMAC_GIT:-git}"

# Captured HERE, at the top level. Inside a function BASH_SOURCE[0] names the
# file the FUNCTION was defined in, which for a script piped into bash is the
# literal string "bash" — dirname of that is ".", so the check below would
# happily decide the current working directory was an omamac checkout.
SCRIPT_SOURCE="${BASH_SOURCE[0]:-}"

# The line that marks an init.lua as ours. Anything carrying it may be rewritten
# on a re-run; anything else is the user's and is never touched.
MARKER="-- Generated by omamac's install script."

log()  { printf '\033[1;32m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$1" >&2; }
err()  { printf '\033[1;31m==>\033[0m %s\n' "$1" >&2; }

usage() {
  cat >&2 <<'EOF'
install [--uninstall] [--help]

  (no flags)    install or upgrade omamac
  --uninstall   remove the PATH symlink and say what is left to remove by hand
EOF
}

# Where this script is running from, if it is running from a file at all. Piped
# into bash there is no such file — BASH_SOURCE is "main" or the shell's own
# name — so the marker is whether bin/omamac sits next to it.
source_checkout() {
  local src="$SCRIPT_SOURCE"
  # Piped into bash, BASH_SOURCE is unset at the top level, so this is empty and
  # there is nothing to install from. (A -f test here would be redundant: the
  # capture above already cannot produce a name that is not a real file.)
  [ -n "$src" ] || return 1
  local dir
  dir=$(cd "$(dirname "$src")" 2>/dev/null && pwd) || return 1
  [ -x "${dir}/bin/omamac" ] || return 1
  printf '%s' "$dir"
}

uninstall() {
  if [ -L "${BIN_DIR}/omamac" ]; then
    rm -f "${BIN_DIR}/omamac"
    log "Removed ${BIN_DIR}/omamac"
  else
    warn "No symlink at ${BIN_DIR}/omamac"
  fi
  cat >&2 <<EOF

Left in place on purpose — remove them yourself if you want them gone:
  ${INSTALL_DIR}                 the checkout
  ${HS_INIT}                     if omamac wrote it, delete the two omamac lines
  ~/.local/state/omamac          your theme, font and other choices
  ~/.cache/omamac                downloaded wallpapers and previews
  the lines you added to ghostty / git / zed / claude configs
EOF
}

case "${1:-}" in
  --uninstall) uninstall; exit 0 ;;
  --help|-h)   usage; exit 0 ;;
  "")          ;;
  *)           err "unknown argument: $1"; usage; exit 1 ;;
esac

# ---------------------------------------------------------------- homebrew --

if ! command -v "$BREW" >/dev/null 2>&1; then
  err "Homebrew is required and was not found."
  cat >&2 <<'EOF'

Install it first, then re-run this:

  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

Deliberately not run for you: it asks for your password, changes ownership of
directories outside this project, and takes several minutes. A script you piped
from the internet should not do that behind your back.
EOF
  exit 1
fi

# ------------------------------------------------------------- the checkout --

here=$(source_checkout || true)
if [ -z "$here" ]; then
  if [ -d "${INSTALL_DIR}/.git" ]; then
    log "Updating ${INSTALL_DIR}..."
    "$GIT" -C "$INSTALL_DIR" pull --ff-only --quiet || {
      err "could not update ${INSTALL_DIR} — resolve it by hand, or delete it and re-run"
      exit 1
    }
  else
    log "Cloning omamac into ${INSTALL_DIR}..."
    mkdir -p "$(dirname "$INSTALL_DIR")"
    "$GIT" clone --quiet "$REPO" "$INSTALL_DIR" || { err "clone failed"; exit 1; }
  fi
  here="$INSTALL_DIR"
else
  log "Installing from ${here}"
fi

[ -x "${here}/bin/omamac" ] || { err "no bin/omamac under ${here}"; exit 1; }

# ----------------------------------------------------------- dependencies --

log "Installing jq..."
"$BREW" list jq >/dev/null 2>&1 || "$BREW" install jq

log "Installing Hammerspoon..."
"$BREW" list --cask hammerspoon >/dev/null 2>&1 || "$BREW" install --cask hammerspoon

# ------------------------------------------------------------------- PATH --

log "Linking omamac into ${BIN_DIR}..."
mkdir -p "$BIN_DIR"
ln -sf "${here}/bin/omamac" "${BIN_DIR}/omamac"

# Being installed somewhere the shell will not look is the most likely way this
# ends in "command not found" with nothing obviously wrong.
case ":${PATH}:" in
  *":${BIN_DIR}:"*) ;;
  *) warn "${BIN_DIR} is not on your PATH. Add this to your shell profile:"
     warn "  export PATH=\"${BIN_DIR}:\$PATH\"" ;;
esac

# ------------------------------------------------------------ hammerspoon --

# An existing init.lua is the user's unless it carries our marker. The previous
# version of this script tested `[ -e ] && [ ! -L ]`, which meant a SYMLINKED
# init.lua — exactly what a dotfiles repo produces — was written straight
# through, clobbering the real file at the other end.
# `-e --` because the marker is a Lua comment and STARTS WITH TWO DASHES: without
# it grep reads the pattern as a flag, exits 2, and every re-run decides it did
# not write its own init.lua and refuses to update it. The stderr redirect that
# used to be here hid the error and made a broken grep look like "not found".
if [ -e "$HS_INIT" ] && ! grep -qF -e "$MARKER" "$HS_INIT"; then
  warn "${HS_INIT} already exists and was not written by this script — leaving it alone."
  warn "Add these two lines to it yourself:"
  warn "  OMAMAC_DIR = \"${here}\""
  warn "  dofile(OMAMAC_DIR .. \"/hammerspoon/omamac.lua\")"
else
  log "Writing ${HS_INIT}..."
  mkdir -p "$(dirname "$HS_INIT")"
  # Written to a temp file and renamed: Hammerspoon watches this path and will
  # happily load a half-written file.
  tmp="${HS_INIT}.omamac.$$"
  cat > "$tmp" <<EOF
${MARKER}
-- OMAMAC_DIR is written in literally because Hammerspoon.app is launched by
-- LaunchServices and inherits no shell environment — an env var set in your
-- profile is invisible to it.
OMAMAC_DIR = "${here}"
dofile(OMAMAC_DIR .. "/hammerspoon/omamac.lua")
EOF
  mv -f "$tmp" "$HS_INIT"
fi

log "Done."
cat <<'EOF'

Next steps:
  1. Launch Hammerspoon (Applications > Hammerspoon), then grant it
     Accessibility permission when macOS prompts you:
     System Settings > Privacy & Security > Accessibility > enable Hammerspoon.
  2. Look for the ◉ in your menu bar, or press cmd+alt+O for the menu and
     cmd+ctrl+space to cycle wallpapers.
  3. Optional, so the other tools follow the theme: add
     `config-file = ?omamac.conf` as the LAST line of your Ghostty config,
     and the delta / Zed / Claude Code / bat / Neovim snippets from README.md.
  4. Run `omamac doctor` to check everything landed.

Upgrade later by re-running this. Remove it with `install --uninstall`.
EOF
